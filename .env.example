# ============================================================
# mestrado-rag-legislativo — Variáveis de Ambiente
# Copie para .env e ajuste conforme seu ambiente
# NUNCA commite o arquivo .env com chaves reais
# ============================================================

# --- Provedor LLM principal ---
# Qual provedor usar para reranking, geração e julgamento
# Opções: deepinfra | openrouter | ollama
LLM_PROVIDER=deepinfra

# --- DeepInfra (recomendado — OpenAI-compatible, $10 = muitos experimentos) ---
# Obter key em: https://deepinfra.com
# DEEPINFRA_API_KEY=...
# DEEPINFRA_TIMEOUT=120
# DEEPINFRA_RERANKER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# DEEPINFRA_GENERATOR_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# DEEPINFRA_JUDGE_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct-Turbo
# DEEPINFRA_QE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# --- Ollama (local — fallback sem internet) ---
OLLAMA_BASE_URL=http://localhost:11434

# Modelo para reranking (precisa ser leve e rápido — pontwise scoring)
# Opções testadas: llama3.2:3b, phi3:mini, mistral:7b, deepseek-r1:7b
OLLAMA_RERANKER_MODEL=llama3.2:3b

# Modelo para geração RAG (pode ser mais poderoso)
# Opções: phi3:mini, phi3:small, llama3.2:3b, deepseek-r1:7b
OLLAMA_GENERATOR_MODEL=phi3:mini

# Timeout em segundos para chamadas Ollama
OLLAMA_TIMEOUT=120

# --- Anthropic API (opcional — para comparação com LLM grande) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_RERANKER_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_GENERATOR_MODEL=claude-sonnet-4-6

# --- OpenRouter API (alternativa ao DeepInfra — 3º juiz LLM) ---
# Obter key em: https://openrouter.ai
# ~$0.40/M tokens para llama-3.3-70b
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_RERANKER_MODEL=meta-llama/llama-3.2-3b-instruct
# OPENROUTER_GENERATOR_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Google Gemini API (2º juiz para cálculo de Cohen's Kappa inter-avaliador) ---
# Obter key em: https://aistudio.google.com/app/apikey
# Modelo: gemini-2.5-flash (comportamento padrão — sem thinking)
# GEMINI_API_KEY=AIza...

# --- LlamaCloud / LlamaParse (leitura de PDFs de papers) ---
# Obter key em: https://cloud.llamaindex.ai
# LLAMA_CLOUD_API_KEY=llx-...
# LLAMA_PARSE_API_KEY=llx-...

# --- Maritaca AI (Gaia/Sabiá — alternativa PT-BR especializada como 3º juiz) ---
# Obter key em: https://maritaca.ai
# MARITACA_API_KEY=...
# MARITACA_JUDGE_MODEL=sabia-3

# --- Dataset Paths ---
# Relativos ao diretório codigos_mestrado/ (raiz do projeto)
BILLS_DATASET_PATH=bills_dataset.csv
FEEDBACK_DATASET_PATH=relevance_feedback_dataset.csv

# --- Embeddings para Dense Retrieval ---
# BGE-M3 (Chen et al. 2024, arXiv:2402.03216): multi-functional, topo MTEB 2024
# Alternativas:
#   "paraphrase-multilingual-MiniLM-L12-v2"   (leve, ~420MB — fallback rápido)
#   "intfloat/multilingual-e5-large"           (sólido, ~2.2GB)
EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
# SLM COMPARISON EXPERIMENTS (slm-comparison-deepinfra branch)
# Paper: SLMs 2025 for RAG in specialized vs. general PT-BR domains
# Ref: Belcak & Wattenhofer (2025) arXiv:2506.02153
# ============================================================

# --- Modelos SLM a comparar (E7 style: BM25+ementa→SLM) ---
# Todos disponíveis no DeepInfra; separados por vírgula
# Ref: mestrado/slm_comparison/TODOS_MODELOS_DEEPINFRA.md — análise completa dos modelos SLM
#
# 7 MODELOS VALIDADOS (Google: 1, Meta: 3, Qwen2.5: 3):
# - google/gemma-3-4b-it
# - meta-llama/Meta-Llama-3.1-8B-Instruct
# - meta-llama/Llama-3.2-3B-Instruct
# - meta-llama/Llama-3.2-1B-Instruct
# - Qwen/Qwen2.5-1.5B-Instruct
# - Qwen/Qwen2.5-3B-Instruct
# - Qwen/Qwen2.5-7B-Instruct
#
# BUGS CONHECIDOS:
# - Phi-4 Mini não está disponível no DeepInfra
# - TODOS os modelos Qwen3.5 (0.8B, 2B, 4B, 9B) têm bug sistêmico no DeepInfra API
#   → Geram tokens mas retornam content='' (vazio) em TODOS os cenários
#   → Confirmado via diagnóstico detalhado (test_qwen_max_tokens.py)
#   → Usar Qwen2.5 em vez de Qwen3.5
#
SLM_MODELS=google/gemma-3-4b-it,meta-llama/Meta-Llama-3.1-8B-Instruct,meta-llama/Llama-3.2-3B-Instruct,meta-llama/Llama-3.2-1B-Instruct,Qwen/Qwen2.5-1.5B-Instruct,Qwen/Qwen2.5-3B-Instruct,Qwen/Qwen2.5-7B-Instruct

# --- Oracle LLM para referência de qualidade (E6 — H5) ---
LLM_ORACLE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- SLM como reranker (E4 variante, estende Sun et al. 2023 para SLMs) ---
SLM_RERANKER_MODEL=microsoft/phi-4-mini-instruct

# --- Controle de experimento ---
# 5 → smoke test | 100 → validação pipeline | 692 → completo Ulysses | 1000 → completo MIRACL
SLM_N_QUERIES=100
SLM_SEED=42

# --- MIRACL Portuguese (cross-domain — Wikipedia PT-BR) ---
# Ref: Zhang et al. (2022) arXiv:2209.05299
MIRACL_LANG=pt
MIRACL_SPLIT=dev

# --- Parâmetros dos Experimentos ---

# Número de queries para experimentos com SLM (subset por limitação de velocidade em CPU)
# TREC usa 50 queries; usamos 200 para maior representatividade
EXPERIMENT_SAMPLE_SIZE=200

# Candidatos para Stage 1 do reranker (top-K do retriever inicial)
EXPERIMENT_TOP_K_RETRIEVAL=50

# Resultados finais avaliados (igual ao num_doc_feedback do dataset original)
EXPERIMENT_RERANK_TOP_N=12

# Parâmetros BM25 (valores padrão robustos de Robertson & Zaragoza, 2009)
BM25_K1=1.5
BM25_B=0.75

# Parâmetro RRF para fusion híbrida (Cormack et al., 2009)
RRF_K=60

# --- Output ---
RESULTS_DIR=results
LOGS_DIR=logs

# --- Logging ---
LOG_LEVEL=INFO
